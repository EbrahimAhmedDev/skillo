{
  "name": "skillo",
  "productName": "Skillo",
  "version": "0.2.0",
  "description": "A visual desktop app for managing agent skills with npx skills",
  "main": "electron/main.cjs",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EbrahimAhmedDev/skillo.git"
  },
  "scripts": {
    "dev": "concurrently -k --names vite,electron --success first \"vite --port 5173 --strictPort\" \"ESK_DEV=1 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "app": "electron .",
    "test": "node test/parsers.test.cjs",
    "smoke": "ESK_SMOKE=1 electron .",
    "package": "electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
